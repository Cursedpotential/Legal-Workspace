# Byline: Grok · grok-4.6 · 2026-08-18
# Service names only — never embed tailnet IPs.

LEGAL_WORKSPACE_ENV=dev
LEGAL_API_SERVICE=legal-api
LEGAL_WEB_SERVICE=legal-web
LEGAL_POSTGRES_SERVICE=legal-postgres
EVIDENCE_PLATFORM_SERVICE=evidence-platform
MODEL_GATEWAY_SERVICE=model-gateway

LEGAL_API_PORT=8010
LEGAL_WEB_PORT=3010

# Same PG18 cluster as Agno; isolated schemas + role.
DATABASE_URL=postgresql://legal_os_app:change-me@legal-postgres:5432/ai

# R2 / S3-compatible object prefix for legal work products only.
LEGAL_OBJECT_PREFIX=legal/
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CF_JWT_SECRET_KEY=your_context_forge_jwt_secret_key_here
CF_GATEWAY_TOKEN=your_context_forge_gateway_token_here
LEGAL_WORKSPACE_BYPASS_AUTH=false
LEGAL_WORKSPACE_JSON_EXPORT_ENABLED=false

# Read-only evidence API. Write path is investigation requests only.
EVIDENCE_PLATFORM_BASE_URL=http://evidence-platform:8000
MODEL_GATEWAY_BASE_URL=http://model-gateway:4000

DISPLAY_TIMEZONE=America/New_York
